package com.apama.latency;

monitor LatencyForwarder
{
	action onload()
	{
		on all _latency_start() as ls { send ls to "com.apama.latency.monitor"; }
		on all _latency_end() as le { send le to "com.apama.latency.monitor"; }
	}
}
